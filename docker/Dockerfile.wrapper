# Test Dockerfile: custom box64 with native ARM64 EOS SDK wrapper.
# Build box64 separately and place the binary at box64-build-out/box64
# before building this image.

FROM --platform=linux/arm64 ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install box64 from ptitSeb's PPA to get runtime dependencies and the bundled
# x86_64 libraries that box64 loads as emulated libs (libgcc_s, libstdc++, etc.).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gettext-base \
        awscli \
        gpg \
        libatomic1 \
        libasound2 \
        libpulse0 \
        libx11-6 \
        libxcursor1 \
        libxrandr2 \
        libxi6 \
    && curl -fsSL https://pi-apps-coders.github.io/box64-debs/KEY.gpg \
        | gpg --dearmor -o /usr/share/keyrings/box64.gpg \
    && echo "deb [arch=arm64 signed-by=/usr/share/keyrings/box64.gpg] https://pi-apps-coders.github.io/box64-debs/debian ./" \
        > /etc/apt/sources.list.d/box64.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        box64-generic-arm \
    && rm -rf /var/lib/apt/lists/*

# Replace the PPA box64 binary with our custom build that includes the EOS SDK
# native ARM64 wrapper.
COPY box64-build-out/box64 /usr/local/bin/box64
RUN chmod +x /usr/local/bin/box64

RUN useradd -m -s /bin/bash steam

COPY --chown=steam:steam server/ /opt/7days/

# NOTE: Do NOT replace libEOSSDK-Linux-Shipping.so with the stub.
# The custom box64 wrapper redirects loads of the x86_64 EOS SDK to the
# native ARM64 libEOSSDK-LinuxArm64-Shipping.so that ships with the game.

RUN mkdir -p /home/steam/.local/share/7DaysToDie/Saves \
    && chown -R steam:steam /home/steam/.local

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 26900/tcp 26900/udp 26901/udp 26902/udp

STOPSIGNAL SIGTERM

USER steam
ENTRYPOINT ["/entrypoint.sh"]
